# Used by `vite --mode e2e` for automated tests. Not a real project:
# a demo-* project id makes the Firebase SDKs talk to local emulators only.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-field-doctor.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-field-doctor
VITE_FIREBASE_STORAGE_BUCKET=demo-field-doctor.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=1:0:web:e2e
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_USE_EMULATORS=true
