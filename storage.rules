rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isStation() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/stations/$(request.auth.uid));
    }

    // cases/{ownerUid}/{caseId}/{index}.jpg
    match /cases/{ownerUid}/{caseId}/{file} {
      allow read: if request.auth != null && (request.auth.uid == ownerUid || isStation());
      allow create: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }
  }
}
