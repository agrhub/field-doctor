{
  "name": "field-doctor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-field-doctor",
    "build:e2e": "tsc -b && vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-field-doctor \"vitest run -c vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.36.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
