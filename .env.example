# Copy to .env.local and fill in values from
# Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic): reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only. Leave empty to have the SDK print a new debug token
# in the browser console, then register it under App Check → Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
